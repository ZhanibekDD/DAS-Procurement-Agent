PROCUREMENT_ENV=development
PROCUREMENT_API_KEY=change-me-server-only
PROCUREMENT_DB_PATH=/data/procurement.db
PROCUREMENT_OUTBOX_MODE=draft_only
PROCUREMENT_AUTH_SECRET=
PROCUREMENT_ADMIN_USERNAME=
PROCUREMENT_ADMIN_PASSWORD_HASH=
PROCUREMENT_SESSION_TTL_SECONDS=28800
# Exact nginx/ingress peer IPs or CIDRs allowed to supply X-Forwarded-For.
PROCUREMENT_TRUSTED_PROXY_IPS=

# Corporate procurement mailbox Timeweb IMAP and SMTP
PROCUREMENT_MAIL_ADDRESS=snab@stroydnepr.ru
PROCUREMENT_MAIL_USERNAME=snab@stroydnepr.ru
# Set exactly one of PASSWORD or PASSWORD_FILE Keep the real value outside git
PROCUREMENT_MAIL_PASSWORD=
# PROCUREMENT_MAIL_PASSWORD_FILE=/run/secrets/procurement_mail_password
PROCUREMENT_MAIL_IMAP_HOST=imap.timeweb.ru
PROCUREMENT_MAIL_IMAP_PORT=993
PROCUREMENT_MAIL_SMTP_HOST=smtp.timeweb.ru
PROCUREMENT_MAIL_SMTP_PORT=465
PROCUREMENT_MAIL_RECEIVE_ENABLED=false
PROCUREMENT_MAIL_SEND_ENABLED=false
PROCUREMENT_MAIL_SYNC_INTERVAL_SECONDS=120
PROCUREMENT_MAIL_SYNC_BATCH_SIZE=100

# Rust spreadsheet extractor bundled into the application image
PROCUREMENT_INGEST_BINARY=/usr/local/bin/das-ingest
PROCUREMENT_INGEST_TIMEOUT_SECONDS=20
